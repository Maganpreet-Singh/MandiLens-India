# =============================================================================
# MANDILENS INDIA — LOCAL ENVIRONMENT TEMPLATE
# =============================================================================
#
# PURPOSE
#   Safe template for local development settings.
#
# SETUP
#   1. Copy this file to ".env" in the repository root.
#      Windows PowerShell:  Copy-Item .env.example .env
#      macOS / Linux:       cp .env.example .env
#   2. Edit ".env" for your own machine.
#   3. Never commit ".env" or place real credentials in this template.
#
# SECURITY
#   - Keep HF_TOKEN empty unless Hugging Face authentication is required.
#   - Do not paste passwords, access tokens, or private keys into this file.
#   - ".env.example" is intended to be committed; ".env" is local-only.
#
# CONVENTIONS
#   - Relative paths are interpreted from the project root by MandiLens code.
#   - Boolean settings use "true" or "false".
#   - Empty optional values mean "use the library/application default".
#   - These variables provide configuration inputs; the application must
#     explicitly load and validate them in its configuration module.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APPLICATION IDENTITY AND RUNTIME
# -----------------------------------------------------------------------------

MANDILENS_APP_NAME="MandiLens India"
MANDILENS_ENV=development
MANDILENS_DEBUG=false
MANDILENS_LOG_LEVEL=INFO
MANDILENS_TIMEZONE=Asia/Kolkata
MANDILENS_RANDOM_SEED=42


# -----------------------------------------------------------------------------
# 2. PROJECT DATA AND OUTPUT DIRECTORIES
# -----------------------------------------------------------------------------
# Keep the original nationwide source data unchanged.
# Processed, interim, analytical, and generated files belong in separate areas.

MANDILENS_DATA_DIR=data
MANDILENS_RAW_DATA_DIR=data/raw
MANDILENS_INTERIM_DATA_DIR=data/interim
MANDILENS_PROCESSED_DATA_DIR=data/processed
MANDILENS_EXTERNAL_DATA_DIR=data/external
MANDILENS_WAREHOUSE_DIR=data/warehouse

MANDILENS_ARTIFACTS_DIR=artifacts
MANDILENS_LOGS_DIR=logs


# -----------------------------------------------------------------------------
# 3. HUGGING FACE DATA ACCESS AND LOCAL CACHE
# -----------------------------------------------------------------------------
# The project's primary dataset is public. A token is generally not required
# for public dataset downloads. Add a token only when authentication is needed.
#
# HF_TOKEN must remain blank in this tracked example file.
# Set the real token only in your local ".env" file or through a secure
# environment-variable mechanism.

HF_TOKEN=
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_ETAG_TIMEOUT=10
HF_HUB_DOWNLOAD_TIMEOUT=60


# -----------------------------------------------------------------------------
# 4. LARGE-SCALE DATA PROCESSING AND DUCKDB
# -----------------------------------------------------------------------------
# MandiLens is designed for the full historical dataset. Do not load the
# complete dataset into Pandas memory. Use DuckDB / Polars and process files
# incrementally.
#
# Leave DUCKDB_MEMORY_LIMIT empty to let DuckDB choose its default.
# Set a value such as "4GB" only after considering the RAM available locally.

MANDILENS_DUCKDB_PATH=data/warehouse/mandilens.duckdb
MANDILENS_DUCKDB_TEMP_DIRECTORY=data/interim/duckdb_tmp
MANDILENS_DUCKDB_THREADS=4
MANDILENS_DUCKDB_MEMORY_LIMIT=

MANDILENS_DOWNLOAD_WORKERS=4
MANDILENS_DOWNLOAD_RETRIES=3
MANDILENS_DOWNLOAD_TIMEOUT_SECONDS=60

MANDILENS_PARQUET_COMPRESSION=zstd
MANDILENS_PRESERVE_RAW_DATA=true


# -----------------------------------------------------------------------------
# 5. LOGGING BEHAVIOUR
# -----------------------------------------------------------------------------

MANDILENS_LOG_TO_CONSOLE=true
MANDILENS_LOG_TO_FILE=true
MANDILENS_LOG_FILE=logs/mandilens.log


# -----------------------------------------------------------------------------
# 6. STREAMLIT LOCAL DASHBOARD
# -----------------------------------------------------------------------------
# Streamlit is the planned primary user interface.
# These settings are for local development, not public production deployment.

STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false


# -----------------------------------------------------------------------------
# 7. FUTURE INTEGRATIONS
# -----------------------------------------------------------------------------
# No weather provider has been selected yet. Do not invent or add provider
# credentials until the source, API terms, and required fields are reviewed.
#
# Add provider-specific settings later in the appropriate configuration step.
# Never store cloud credentials, database passwords, or production secrets here.


# =============================================================================
# END OF TEMPLATE
# =============================================================================
